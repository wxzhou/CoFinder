{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions for CoFinder windows",
  "windows": [
    "main",
    "content"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize"
  ]
}
