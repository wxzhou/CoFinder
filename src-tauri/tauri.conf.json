{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CoFinder",
  "version": "1.9.10",
  "identifier": "com.wxzhou.cofinder",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run build:electron && npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer && node scripts/build-sidecar-sea.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoFinder",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "CoFinder - macOS remote file explorer",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/cofinder-sidecar"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
